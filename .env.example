# Local development. Leave DATABASE_URL unset to use SQLite (instance/sat_practice.db).
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_SCHEMA=sat
SECRET_KEY=change-me
# Same Supabase project as the online course platform (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Extra admins besides public.admins (optional; needed for local SQLite dev)
# ADMIN_EMAILS=you@example.com
